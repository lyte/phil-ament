{
  "name": "phil-ament",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "futuristicvlad",
  "license": "MIT",
  "description": "Self-hosted filament inventory for 3D-printing hobbyists.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "node build/index.js",
    "test": "vitest run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "icons": "node scripts/render-icons.mjs",
    "catalog": "python3 scripts/build-catalog.py",
    "catalog:update": "python3 scripts/update-catalog.py",
    "smoke": "node scripts/smoke.mjs",
    "prepare": "svelte-kit sync || echo ''"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/kit": "^2.48.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.7",
    "svelte": "^5.43.0",
    "vite": "^7.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
